{
  "name": "o2-ticket-booking",
  "version": "1.0.0",
  "description": "O2 Arena Dua Lipa concert ticket booking system (university assignment)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "seed": "node backend/seed/seed.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "keywords": ["tickets", "mongodb", "express", "o2-arena"],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.0",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
