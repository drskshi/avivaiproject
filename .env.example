# Copy to .env and fill in real values. Never commit .env.

MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_URI=mongodb+srv://your_atlas_username:your_atlas_password@cluster0.example.mongodb.net/o2-ticket-booking?retryWrites=true&w=majority

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# SMTP (Nodemailer — real email for verification + ticket confirmation)
# Leave blank to use Ethereal test inbox (preview link shown in the UI).
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_16_char_app_password   (not your normal Gmail password)
#   SMTP_FROM="O2 Tickets <you@gmail.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="O2 Tickets <noreply@example.com>"

# Event
EVENT_NAME=Dua Lipa Live at The O2
EVENT_VENUE=The O2 Arena
EVENT_DATE=2026-11-30T19:00:00.000Z
EVENT_CAPACITY=1000
TICKET_SALES_START=2026-07-01T00:00:00.000Z

# Seed admin (pre-verified)
ADMIN_EMAIL=admin@o2tickets.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
